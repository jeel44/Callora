<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CalloraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Callora">

        <!-- TODO(before release): Google's official TEST AdMob App ID. MUST be swapped for
             Callora's real AdMob App ID before any release build — shipping with this ID means no
             real ad revenue. Pairs with the test ad unit ID default in RemoteConfigManager. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Callora"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Alternate component name for MainActivity, used only by InCallServiceImpl when
             launching the incoming-call UI. The system paints the cold-start "starting window"
             from whichever theme is declared in the manifest for the launched component, BEFORE
             any app code (including Activity.setTheme()) runs — so a plain setTheme() call in
             MainActivity.onCreate() can never prevent the initial white flash on a truly cold
             start. Targeting this alias (with its own dark android:theme) instead makes the
             starting window itself dark from the very first frame. -->
        <activity-alias
            android:name=".IncomingCallActivityAlias"
            android:targetActivity=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Callora.IncomingCall" />

        <!-- Truecaller-style post-call popup (see CallEndedActivity's own doc). Plain Activity,
             not a system overlay — no SYSTEM_ALERT_WINDOW permission involved. exported=false:
             only ever launched internally from InCallServiceImpl. singleTask so a second call
             ending in quick succession reuses this instance instead of stacking popups. -->
        <activity
            android:name=".ui.screens.callended.CallEndedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Callora.CallEnded" />

        <service
            android:name=".telecom.CalloraCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <service
            android:name=".telecom.InCallServiceImpl"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>

            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
        </service>

        <!-- Handles the missed-call notification's Block/Dismiss actions (see
             MissedCallNotifier) — only ever targeted by this app's own PendingIntents. -->
        <receiver
            android:name=".telecom.MissedCallActionReceiver"
            android:exported="false" />

        <!-- Declaring a component for this action is what stops the platform's own Telecom
             service from posting its own missed-call notification alongside Callora's (see
             MissedCallSystemNotificationReceiver's own doc). Sent by com.android.server.telecom,
             a different package/UID, so this must be exported. -->
        <receiver
            android:name=".telecom.MissedCallSystemNotificationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>