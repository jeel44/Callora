<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A phone app is useless without telephony: keeps Play from offering it to such devices
         (SetDefaultScreen's mandatory default-phone-app gate couldn't be passed there anyway). -->
    <uses-feature android:name="android.hardware.telephony" android:required="true" />

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Settings shows the device's own number (TelephonyManager.line1Number), which needs this on
         API 26+. Requested together with READ_PHONE_STATE in Home's call-log permission bundle. -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- InCallServiceImpl goes foreground (type phoneCall) while a call is up: Android 12+ only
         accepts a CallStyle notification from a foreground service (or one with a full-screen
         intent). phoneCall is allowed because this app holds MANAGE_OWN_CALLS / the dialer role. -->
    <!-- "Display over other apps", requested from SetDefaultScreen. Not used to draw an overlay
         window: holding it is what allows CallMonitorService/PostCallPhoneStateReceiver to open
         CallEndedActivity from the background when this app is not the default phone app. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- CallMonitorService: watches for calls ending while this app is not the default phone app
         (see its own doc). RECEIVE_BOOT_COMPLETED restarts it after a reboot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".CalloraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Callora">

        <!-- TODO(before release): Google's official TEST AdMob App ID. MUST be swapped for
             Callora's real AdMob App ID before any release build — shipping with this ID means no
             real ad revenue. Pairs with the test ad unit ID default in RemoteConfigManager. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Callora.Starting"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="tel" />
            </intent-filter>
            <!-- tel: links opened with VIEW (web pages, chat apps) — same as DIAL: the dialpad
                 opens prefilled, see MainActivity.dialNumberFromIntent. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Alternate component name for MainActivity, used only by InCallServiceImpl when
             launching the incoming-call UI. The system paints the cold-start "starting window"
             from whichever theme is declared in the manifest for the launched component, BEFORE
             any app code (including Activity.setTheme()) runs — so a plain setTheme() call in
             MainActivity.onCreate() can never prevent the initial white flash on a truly cold
             start. Targeting this alias (with its own dark android:theme) instead makes the
             starting window itself dark from the very first frame. -->
        <activity-alias
            android:name=".IncomingCallActivityAlias"
            android:targetActivity=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Callora.IncomingCall" />

        <!-- The full-screen call-ended screen (see CallEndedActivity's own doc). Plain Activity,
             not a system overlay window. exported=false: only ever launched internally, from
             InCallServiceImpl (default phone app) or the PostCallMonitor triggers (not default). singleTask so a second call
             ending in quick succession reuses this instance instead of stacking popups. -->
        <activity
            android:name=".ui.screens.callended.CallEndedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Callora.CallEnded"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

        <!-- The same screen as started by the system: Telecom sends POST_CALL to the app holding
             the CALL_SCREENING role after every completed call (API 30+). See PostCallActivity. -->
        <activity
            android:name=".ui.screens.callended.PostCallActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Callora.CallEnded"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.telecom.action.POST_CALL" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".telecom.CalloraCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <service
            android:name=".telecom.InCallServiceImpl"
            android:exported="true"
            android:foregroundServiceType="phoneCall"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>

            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
        </service>

        <!-- Handles the missed-call notification's Block/Dismiss actions (see
             MissedCallNotifier) — only ever targeted by this app's own PendingIntents. -->
        <receiver
            android:name=".telecom.MissedCallActionReceiver"
            android:exported="false" />

        <!-- Declaring a component for this action is what stops the platform's own Telecom
             service from posting its own missed-call notification alongside Callora's (see
             MissedCallSystemNotificationReceiver's own doc). Sent by com.android.server.telecom,
             a different package/UID, so this must be exported. -->
        <receiver
            android:name=".telecom.MissedCallSystemNotificationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- Call-ended screen while NOT the default phone app (see PostCallMonitor). PHONE_STATE
             is a protected broadcast only the system can send, and one of the few implicit
             broadcasts a manifest receiver still gets. -->
        <receiver
            android:name=".telecom.PostCallPhoneStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".telecom.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".telecom.CallMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Detects when a phone call ends so the caller details screen can be shown while the app is not the default phone app" />
        </service>
    </application>

</manifest>